[Unit]
Description=sleepy - TV + RGB on at boot
After=network.target
Wants=network.target

[Service]
Type=oneshot
Environment=SLEEPY_HOME=/home/tom/.local/share/sleepy
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/home/tom/.local/share/sleepy/sleepy-ctl on

[Install]
WantedBy=multi-user.target