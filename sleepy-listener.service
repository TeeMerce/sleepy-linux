[Unit]
Description=sleepy - TV + RGB screen-lock companion
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/share/sleepy/venv/bin/python %h/.local/share/sleepy/sleepy-listener.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target