[Unit]
Description=sleepy - TV + RGB off on suspend/hibernate
Before=sleep.target
After=network.target
DefaultDependencies=no

[Service]
Type=oneshot
Environment=SLEEPY_HOME=/home/tom/.local/share/sleepy
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/home/tom/.local/share/sleepy/sleepy-ctl off

[Install]
WantedBy=sleep.target